## Dev-only packages.
## Installed only when $INSTALL_DEV is set (see ~/.config/yadm/bootstrap).
## Workstation-default packages live in ~/.Brewfile.

## Agent tooling (installed elsewhere)
# brew 'pi-coding-agent'
# cask 'claude-code'

## Install dev apps
cask 'bruno'
cask 'handy'

## Network/security CLI tools
brew 'gnutls'
brew 'nmap'
brew 'telnet'
brew 'wireshark'

## Dev
brew 'automake'
brew 'bash'
brew 'bat'
brew 'eza'
brwe 'gh'
brew 'git'
brew 'git-lfs'
brew 'go'
brew 'jq'
brew 'make'
brew 'nano'
brew 'openssl'
brew 'peco'
brew 'rpm'
brew 'tcpdump'
brew 'whois'
brew 'zlib'

## Dev/Containers
brew 'kubernetes-cli' # i.e. kubectl
brew 'helm'
cask 'docker'
